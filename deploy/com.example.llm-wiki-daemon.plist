<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template. Replace __PROJECT_DIR__ and __LOG_DIR__ with absolute paths
  on your machine, rename the file (e.g. com.example.llm-wiki-daemon.plist ->
  com.<you>.llm-wiki-daemon.plist), copy it to ~/Library/LaunchAgents/ and run:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/<your-label>.plist
  No credentials belong in this file.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.llm-wiki-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/target/release/llm-wiki-daemon</string>
        <string>__PROJECT_DIR__/config.toml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/stderr.log</string>

    <!-- No credentials in this file. The daemon defaults to loopback and reads
         its optional token from LLM_WIKI_DAEMON_TOKEN at runtime. -->
</dict>
</plist>
